rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /orders/{orderId} { allow create: if request.resource.data.keys().hasAll(['code','username','packageId','amount','total','status','createdAt']); allow read, update: if isAdmin(); }
    match /packages/{packageId} { allow read: if true; allow write: if isAdmin(); }
    match /admins/{adminId} { allow read: if request.auth.uid == adminId; allow write: if false; }
  }
}
