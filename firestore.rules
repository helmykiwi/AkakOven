rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validText(value, limit) { return value is string && value.size() <= limit; }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['customerName','whatsapp','fulfilment','orderDate','address','driverNote','note','items','total','status','paymentStatus','paymentProvider','deliveryStatus','driverId','createdAt'])
        && request.resource.data.keys().hasAll(['customerName','whatsapp','fulfilment','orderDate','items','total','status','paymentStatus','createdAt'])
        && validText(request.resource.data.customerName,100) && validText(request.resource.data.whatsapp,30)
        && request.resource.data.fulfilment in ['pickup','delivery']
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total <= 10000
        && request.resource.data.status == 'New order' && request.resource.data.paymentStatus == 'Awaiting confirmation';
      allow read, update, delete: if isAdmin();
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /drivers/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }
    match /admins/{id} { allow read: if request.auth != null && request.auth.uid == id; allow write: if false; }
  }
}
