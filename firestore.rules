rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /checkoutIntents/{id} {
      allow create: if request.resource.data.keys().hasOnly(['customerName','whatsapp','fulfilment','deliveryMethod','orderDate','address','driverNote','selfDeliveryNote','note','items','total','shippingProvider','shippingQuoteId','shippingFee','shippingDistanceKm','shippingQuoteExpiresAt','shippingAddress','state','createdAt'])
        && request.resource.data.keys().hasAll(['customerName','whatsapp','fulfilment','deliveryMethod','orderDate','items','total','state','createdAt'])
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 100
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() > 0 && request.resource.data.whatsapp.size() <= 30
        && request.resource.data.fulfilment in ['pickup','delivery']
        && ((request.resource.data.fulfilment == 'pickup' && request.resource.data.deliveryMethod == 'pickup_or_self_arrange') || (request.resource.data.fulfilment == 'delivery' && request.resource.data.deliveryMethod == 'akakoven_delivery'))
        && request.resource.data.orderDate is string
        && (request.resource.data.fulfilment != 'delivery' || (request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 1000))
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 10000
        && (request.resource.data.fulfilment == 'pickup' || (
          request.resource.data.shippingProvider == 'Lalamove'
          && request.resource.data.shippingQuoteId is string
          && request.resource.data.shippingFee is number
          && request.resource.data.shippingDistanceKm is number
          && request.resource.data.shippingDistanceKm <= 15
          && request.resource.data.shippingAddress is string
          && exists(/databases/$(database)/documents/deliveryQuotes/$(request.resource.data.shippingQuoteId))
          && get(/databases/$(database)/documents/deliveryQuotes/$(request.resource.data.shippingQuoteId)).data.state == 'quoted'
          && get(/databases/$(database)/documents/deliveryQuotes/$(request.resource.data.shippingQuoteId)).data.deliveryFee == request.resource.data.shippingFee
          && get(/databases/$(database)/documents/deliveryQuotes/$(request.resource.data.shippingQuoteId)).data.distanceMeters <= 15000
          && get(/databases/$(database)/documents/deliveryQuotes/$(request.resource.data.shippingQuoteId)).data.expiresAt > request.time
        ))
        && request.resource.data.state == 'created'
        && request.resource.data.createdAt == request.time;
      allow get: if isAdmin();
      allow list, update, delete: if isAdmin();
    }

    match /deliveryQuotes/{id} {
      allow read, write: if false;
    }
    match /shippingRateLimits/{id} {
      allow read, write: if false;
    }

    match /orders/{id} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /drivers/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} {
      allow read: if id == 'commerce';
      allow write: if isAdmin();
    }
    match /admins/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }
  }
}
