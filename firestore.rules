rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validText(value, maxLength) { return value is string && value.size() <= maxLength; }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['customerName','whatsapp','product','category','quantity','eventDate','signingOff','cardNote','cardSize','note','status','paymentStatus','createdAt'])
        && request.resource.data.keys().hasAll(['customerName','whatsapp','product','category','quantity','status','createdAt'])
        && validText(request.resource.data.customerName, 100) && validText(request.resource.data.whatsapp, 30)
        && validText(request.resource.data.product, 100) && validText(request.resource.data.category, 30)
        && request.resource.data.quantity is int && request.resource.data.quantity >= 10 && request.resource.data.quantity <= 10000
        && request.resource.data.status == 'New request' && request.resource.data.paymentStatus == 'Awaiting quotation'
        && validText(request.resource.data.createdAt, 40);
      allow read, update, delete: if isAdmin();
    }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /admins/{id} { allow read: if request.auth != null && request.auth.uid == id; allow write: if false; }
  }
}
