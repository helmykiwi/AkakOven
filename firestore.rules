rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /orders/{orderId} { allow create: if request.resource.data.keys().hasAll(['code','username','packageId','amount','total','status','createdAt']); allow read: if isAdmin(); allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptPath']); allow delete: if isAdmin(); }
    match /packages/{packageId} { allow read: if true; allow write: if isAdmin(); }
    match /admins/{adminId} {
      allow read: if request.auth.uid == adminId;
      allow create: if request.auth.uid == adminId && request.auth.token.email == 'bettygrv3@gmail.com';
      allow update, delete: if false;
    }
    match /feedback/{feedbackId} { allow create: if request.resource.data.keys().hasAll(['orderCode','rating','createdAt']); allow read: if isAdmin(); }
    match /tracking/{trackingId} { allow create: if request.resource.data.keys().hasAll(['code','username','amount','total','status','createdAt']); allow read: if resource.data.status == 'Pending review'; allow update, delete: if isAdmin(); }
  }
}
