{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".impeccable/**",
      ".firebase/**",
      "BB-Topup/**",
      "dessert/**",
      "littlewhimsy/**",
      "supabase/**",
      "public/choookies/**",
      "**/*.tar.gz",
      "node_modules/**",
      "README.md",
      "PRODUCT.md",
      "firestore.rules",
      "storage.rules",
      "functions/**",
      ".env*",
      "netlify/**",
      "netlify.toml"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
